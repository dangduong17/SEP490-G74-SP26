@{
    ViewData["Title"] = "RJMS - Recruitment System";
}

<div class="hero-section">
    <div class="container">
        <div class="hero-content">
            <h1 class="hero-title">RJMS</h1>
            <p class="hero-subtitle">Recruitment Job Management System</p>
            <div class="hero-buttons">
                <a asp-controller="Candidates" asp-action="JobList" class="btn btn-primary btn-lg">Find Jobs</a>
                <a asp-controller="Recruiter" asp-action="JobPostingList" class="btn btn-outline-light btn-lg">Post
                    Jobs</a>
                </div>
            </div>
        </div>
    </div>

    <div class="features-section">
        <div class="container">
            <h2 class="section-title">Why Choose RJMS?</h2>
            <div class="row">
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-search"></i>
                        </div>
                        <h3>Smart Job Search</h3>
                        <p>Find the perfect job with our advanced search and matching system.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <h3>Talent Management</h3>
                        <p>Manage candidates and find the best talent for your organization.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h3>Analytics Dashboard</h3>
                        <p>Track performance and get insights with detailed analytics.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>