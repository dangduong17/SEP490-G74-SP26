@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to RJMS</h1>
    <p class="lead">Recruitment Job Management System</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">For Job Seekers</h5>
                <p class="card-text">Create your profile, upload CVs, and apply for exciting job opportunities.</p>
                @if (User.Identity!.IsAuthenticated && User.IsInRole("Candidate"))
                {
                    <a href="#" class="btn btn-primary">View Jobs</a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">Get Started</a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">For Recruiters</h5>
                <p class="card-text">Post job openings, manage candidates, and find the perfect talent for your organization.</p>
                @if (User.Identity!.IsAuthenticated && (User.IsInRole("Recruiter") || User.IsInRole("Admin")))
                {
                    <a asp-controller="Jobs" asp-action="Create" class="btn btn-success">Post a Job</a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-success">Join as Recruiter</a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Features</h5>
                <ul class="list-unstyled">
                    <li>✓ User Authentication & Authorization</li>
                    <li>✓ Candidate Management</li>
                    <li>✓ CV Management</li>
                    <li>✓ Job Management</li>
                    <li>✓ Application Tracking</li>
                </ul>
            </div>
        </div>
    </div>
</div>