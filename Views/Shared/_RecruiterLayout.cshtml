@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nhà tuyển dụng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --recruiter-primary: #0ea5e9;
            --recruiter-dark: #0f172a;
            --recruiter-muted: #64748b;
            --recruiter-border: #dbeafe;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(180deg, #eff7ff 0%, #f8fbff 100%);
        }
        .recruiter-shell { min-height: 100vh; display: flex; }
        .recruiter-sidebar {
            width: 280px; background: #fff; border-right: 1px solid var(--recruiter-border);
            position: fixed; inset: 0 auto 0 0; z-index: 1000; overflow-y: auto;
        }
        .brand-box {
            padding: 28px 24px; border-bottom: 1px solid var(--recruiter-border);
            background: linear-gradient(135deg, rgba(14,165,233,.12), rgba(14,165,233,.03));
        }
        .brand-name { color: var(--recruiter-primary); font-weight: 800; font-size: 1.3rem; margin: 0; }
        .brand-sub { color: var(--recruiter-muted); font-size: .86rem; margin: .35rem 0 0; }
        .recruiter-nav { padding: 18px 10px; }
        .recruiter-nav .nav-link {
            color: #1f2937; border-radius: 10px; margin: 6px 8px; padding: 12px 14px;
            font-weight: 600; display: flex; align-items: center; gap: 10px;
        }
        .recruiter-nav .nav-link.active, .recruiter-nav .nav-link:hover {
            background: #e8f7ff; color: #0284c7;
        }
        .recruiter-main { flex: 1; margin-left: 280px; padding: 28px; }
        .recruiter-topbar {
            background: #fff; border: 1px solid var(--recruiter-border); border-radius: 14px; padding: 18px 20px;
            margin-bottom: 22px; display: flex; align-items: center; justify-content: space-between;
        }
        .recruiter-topbar h2 { margin: 0; font-size: 1.35rem; font-weight: 800; color: var(--recruiter-dark); }
        .role-pill {
            background: #e6f7ff; color: #0369a1; border: 1px solid #bae6fd; font-weight: 700;
            padding: 8px 12px; border-radius: 999px; font-size: .8rem;
        }
        .recruiter-card {
            background: #fff; border: 1px solid var(--recruiter-border); border-radius: 14px;
            padding: 20px; box-shadow: 0 10px 24px rgba(2, 132, 199, .05);
        }
        @@media (max-width: 991px) {
            .recruiter-sidebar { position: static; width: 100%; height: auto; }
            .recruiter-shell { flex-direction: column; }
            .recruiter-main { margin-left: 0; padding: 18px; }
            .recruiter-topbar { flex-direction: column; align-items: flex-start; gap: 10px; }
        }
    </style>
</head>
<body>
    <div class="recruiter-shell">
        <aside class="recruiter-sidebar">
            <div class="brand-box">
                <p class="brand-name">Finding Jobs Recruiter</p>
                <p class="brand-sub">@Context.Session.GetString("UserEmail")</p>
            </div>
            <nav class="recruiter-nav nav flex-column">
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "RecruiterDashboard" ? "active" : "")"
                   asp-controller="Recruiter" asp-action="RecruiterDashboard">
                    <i class="fa-solid fa-chart-line"></i> Bảng điều khiển
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "EditProfile" ? "active" : "")"
                   asp-controller="Recruiter" asp-action="EditProfile">
                    <i class="fa-solid fa-id-card"></i> Hồ sơ tuyển dụng
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "JobPostingList" ? "active" : "")"
                   asp-controller="Recruiter" asp-action="JobPostingList">
                    <i class="fa-solid fa-briefcase"></i> Tin tuyển dụng
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "CreateJob" ? "active" : "")"
                   asp-controller="Recruiter" asp-action="CreateJob">
                    <i class="fa-solid fa-plus"></i> Đăng tin mới
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="px-3 mt-3">
                    <button type="submit" class="btn btn-outline-danger w-100">Đăng xuất</button>
                </form>
            </nav>
        </aside>

        <main class="recruiter-main">
            <div class="recruiter-topbar">
                <h2>@ViewData["Title"]</h2>
                <span class="role-pill">@Context.Session.GetString("UserRole")</span>
            </div>
            @if (TempData["SuccessToast"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessToast"]</div>
            }
            <div class="recruiter-card">
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
