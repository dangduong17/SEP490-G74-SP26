@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --topcv-green: #00b14f;
            --topcv-dark: #0f172a;
            --topcv-muted: #64748b;
            --topcv-bg: #f6fbf8;
            --topcv-border: #d7efe1;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(180deg, #eef9f2 0%, #f8fbff 100%);
        }

        .admin-shell {
            min-height: 100vh;
            display: flex;
        }

        .admin-sidebar {
            width: 280px;
            background: #ffffff;
            border-right: 1px solid var(--topcv-border);
            position: fixed;
            inset: 0 auto 0 0;
            z-index: 1000;
            overflow-y: auto;
        }

        .brand-box {
            padding: 28px 24px;
            border-bottom: 1px solid var(--topcv-border);
            background: linear-gradient(135deg, rgba(0,177,79,.09), rgba(0,177,79,.02));
        }

        .brand-name {
            color: var(--topcv-green);
            font-weight: 800;
            font-size: 1.3rem;
            margin: 0;
        }

        .brand-sub {
            color: var(--topcv-muted);
            font-size: .86rem;
            margin: .35rem 0 0;
        }

        .admin-nav {
            padding: 18px 10px;
        }

        .admin-nav .nav-link {
            color: #1f2937;
            border-radius: 10px;
            margin: 6px 8px;
            padding: 12px 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .admin-nav .nav-link.active,
        .admin-nav .nav-link:hover {
            background: #ecfff4;
            color: var(--topcv-green);
        }

        .admin-main {
            flex: 1;
            margin-left: 280px;
            padding: 28px;
        }

        .admin-topbar {
            background: #fff;
            border: 1px solid var(--topcv-border);
            border-radius: 14px;
            padding: 18px 20px;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .admin-topbar h2 {
            margin: 0;
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--topcv-dark);
        }

        .role-pill {
            background: #e8fff2;
            color: #05803c;
            border: 1px solid #b8f0ce;
            font-weight: 700;
            padding: 8px 12px;
            border-radius: 999px;
            font-size: .8rem;
        }

        .admin-card {
            background: #fff;
            border: 1px solid var(--topcv-border);
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 10px 24px rgba(0, 55, 24, .04);
        }

        .btn-topcv {
            background: var(--topcv-green);
            border-color: var(--topcv-green);
            color: #fff;
        }

        .btn-topcv:hover {
            background: #009744;
            border-color: #009744;
            color: #fff;
        }

        @@media (max-width: 991px) {
            .admin-sidebar {
                position: static;
                width: 100%;
                height: auto;
            }

            .admin-shell {
                flex-direction: column;
            }

            .admin-main {
                margin-left: 0;
                padding: 18px;
            }

            .admin-topbar {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <div class="brand-box">
                <p class="brand-name">Finding Jobs Admin</p>
                <p class="brand-sub">@Context.Session.GetString("UserEmail")</p>
            </div>

            <nav class="admin-nav nav flex-column">
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Admin" asp-action="Index">
                    <i class="fa-solid fa-chart-line"></i> Bảng điều khiển
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "UserList" ? "active" : "")"
                   asp-controller="Admin" asp-action="UserList">
                    <i class="fa-solid fa-users"></i> Quản lý người dùng
                </a>
                <a class="nav-link" asp-controller="Admin" asp-action="CreateAdmin">
                    <i class="fa-solid fa-user-shield"></i> Tạo admin
                </a>
                <a class="nav-link" asp-controller="Admin" asp-action="CreateCandidate">
                    <i class="fa-solid fa-user"></i> Tạo ứng viên
                </a>
                <a class="nav-link" asp-controller="Admin" asp-action="CreateRecruiter">
                    <i class="fa-solid fa-user-tie"></i> Tạo nhà tuyển dụng
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="px-3 mt-3">
                    <button type="submit" class="btn btn-outline-danger w-100">Đăng xuất</button>
                </form>
            </nav>
        </aside>

        <main class="admin-main">
            <div class="admin-topbar">
                <h2>@ViewData["Title"]</h2>
                <span class="role-pill">@Context.Session.GetString("UserRole")</span>
            </div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            <div class="admin-card">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        toastr.options = { closeButton: true, progressBar: true, positionClass: 'toast-top-right', timeOut: 5000 };
        @if (TempData["SuccessToast"] != null) { <text>toastr.success('@Html.Raw(TempData["SuccessToast"])');</text> }
        @if (TempData["ErrorToast"]   != null) { <text>toastr.error('@Html.Raw(TempData["ErrorToast"])');</text> }
        @if (TempData["InfoToast"]    != null) { <text>toastr.info('@Html.Raw(TempData["InfoToast"])');</text> }
        @if (TempData["WarningToast"] != null) { <text>toastr.warning('@Html.Raw(TempData["WarningToast"])');</text> }
        @if (TempData["Error"]        != null) { <text>toastr.error('@Html.Raw(TempData["Error"])');</text> }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
