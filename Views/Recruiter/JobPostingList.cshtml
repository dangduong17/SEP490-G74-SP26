@{
    ViewData["Title"] = "Quản lý tin tuyển dụng";
    Layout = "~/Views/Shared/_RecruiterLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Tin tuyển dụng của bạn</h4>
    <a asp-action="CreateJob" class="btn btn-primary">Đăng tin mới</a>
</div>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item"><a class="nav-link active" href="#">Tất cả (15)</a></li>
    <li class="nav-item"><a class="nav-link" href="#">Đang tuyển (8)</a></li>
    <li class="nav-item"><a class="nav-link" href="#">Hết hạn (5)</a></li>
    <li class="nav-item"><a class="nav-link" href="#">Nháp (2)</a></li>
</ul>

<div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Vị trí tuyển dụng</th>
                <th>Ngày đăng</th>
                <th>Hết hạn</th>
                <th>Ứng viên</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < 10; i++)
            {
                <tr>
                    <td>
                        <strong>Nhân viên kinh doanh (@(i + 1))</strong><br />
                        <small class="text-muted">Hà Nội • Full-time • 15-25 triệu</small>
                    </td>
                    <td>01/02/2026</td>
                    <td>01/03/2026</td>
                    <td><span class="badge bg-info">25 ứng viên</span></td>
                    <td><span class="badge bg-success">Đang tuyển</span></td>
                    <td>
                        <div class="btn-group btn-group-sm">
                            <a href="#" class="btn btn-outline-primary">Xem</a>
                            <a href="#" class="btn btn-outline-secondary">Sửa</a>
                            <a href="#" class="btn btn-outline-danger">Xóa</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
