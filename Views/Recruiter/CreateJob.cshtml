@{
    ViewData["Title"] = "Đăng tin tuyển dụng";
    Layout = "~/Views/Shared/_RecruiterLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">Đăng tin tuyển dụng mới</h4>
            </div>
            <div class="card-body">
                <form method="post" class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Vị trí tuyển dụng <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="title" placeholder="Ví dụ: Nhân viên kinh doanh" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Ngành nghề <span class="text-danger">*</span></label>
                        <select class="form-select" name="category" required>
                            <option value="">Chọn ngành nghề</option>
                            <option>IT - Phần mềm</option>
                            <option>Marketing</option>
                            <option>Kinh doanh</option>
                            <option>Kế toán</option>
                            <option>Nhân sự</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Địa điểm <span class="text-danger">*</span></label>
                        <select class="form-select" name="location" required>
                            <option value="">Chọn địa điểm</option>
                            <option>Hà Nội</option>
                            <option>TP. Hồ Chí Minh</option>
                            <option>Đà Nẵng</option>
                            <option>Hải Phòng</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Mức lương</label>
                        <input type="text" class="form-control" name="salary" placeholder="Ví dụ: 15-25 triệu" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Loại hình công việc</label>
                        <select class="form-select" name="jobType">
                            <option>Full-time</option>
                            <option>Part-time</option>
                            <option>Contract</option>
                            <option>Internship</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Kinh nghiệm</label>
                        <select class="form-select" name="experience">
                            <option>Không yêu cầu</option>
                            <option>Dưới 1 năm</option>
                            <option>1-2 năm</option>
                            <option>2-5 năm</option>
                            <option>Trên 5 năm</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Số lượng tuyển</label>
                        <input type="number" class="form-control" name="positions" value="1" min="1" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Mô tả công việc <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="description" rows="5" required></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Yêu cầu công việc <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="requirements" rows="5" required></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Quyền lợi</label>
                        <textarea class="form-control" name="benefits" rows="4"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Hạn nộp hồ sơ <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" name="deadline" required />
                    </div>

                    <div class="col-12 d-flex gap-2 justify-content-end">
                        <a asp-action="JobPostingList" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" name="action" value="draft" class="btn btn-outline-primary">Lưu nháp</button>
                        <button type="submit" name="action" value="publish" class="btn btn-primary">Đăng tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
