@{
    ViewData["Title"] = "Dashboard Nhà tuyển dụng";
}

<section class="page-section">
    <div class="container">
        <h2 class="page-title">Dashboard Nhà tuyển dụng</h2>

        <!-- Stats Cards -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-primary">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <div class="stat-content">
                        <h3>15</h3>
                        <p>Tin tuyển dụng</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-success">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <div class="stat-content">
                        <h3>245</h3>
                        <p>Ứng viên</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-warning">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-content">
                        <h3>48</h3>
                        <p>Chờ xem xét</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-info">
                        <i class="fas fa-eye"></i>
                    </div>
                    <div class="stat-content">
                        <h3>1,234</h3>
                        <p>Lượt xem</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Recent Applications -->
            <div class="col-lg-8 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Ứng viên mới nhất</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Ứng viên</th>
                                        <th>Vị trí</th>
                                        <th>Ngày nộp</th>
                                        <th>Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <tr>
                                            <td>
                                                <strong>Nguyễn Văn A</strong>
                                                <br>
                                                <small class="text-muted">3 năm kinh nghiệm</small>
                                            </td>
                                            <td>Nhân viên kinh doanh</td>
                                            <td>06/02/2026</td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-outline-primary">Xem CV</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="col-lg-4 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Thao tác nhanh</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a asp-action="CreateJob" class="btn btn-primary">
                                Đăng tin tuyển dụng mới
                            </a>
                            <a asp-action="JobPostingList" class="btn btn-outline-primary">
                                Quản lý tin tuyển dụng
                            </a>
                            <a href="#" class="btn btn-outline-secondary">
                                Tìm kiếm ứng viên
                            </a>
                            <a href="#" class="btn btn-outline-info">
                                Báo cáo thống kê
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Job Performance -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="mb-0">Hiệu suất tuyển dụng</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small>Tỷ lệ phản hồi</small>
                                <small><strong>75%</strong></small>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-success" style="width: 75%"></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small>Tin đang hoạt động</small>
                                <small><strong>8/15</strong></small>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-primary" style="width: 53%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="d-flex justify-content-between mb-1">
                                <small>Hồ sơ chất lượng</small>
                                <small><strong>60%</strong></small>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-info" style="width: 60%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>