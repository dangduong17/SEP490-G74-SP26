@model vn.edu.fpt.dto.RecruiterDashboardViewModel
@{
    ViewData["Title"] = "Dashboard nhà tuyển dụng";
    Layout = "~/Views/Shared/_RecruiterLayout.cshtml";
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="mb-3">Thông tin nhà tuyển dụng</h5>
                <p class="mb-1"><strong>Họ tên:</strong> @Model.RecruiterName</p>
                <p class="mb-1"><strong>Email:</strong> @Model.RecruiterEmail</p>
                <p class="mb-1"><strong>Số điện thoại:</strong> @(string.IsNullOrWhiteSpace(Model.RecruiterPhone) ? "-" : Model.RecruiterPhone)</p>
                <p class="mb-0"><strong>Vị trí:</strong> @(string.IsNullOrWhiteSpace(Model.Position) ? "-" : Model.Position)</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="mb-3">Thông tin công ty</h5>
                <p class="mb-1"><strong>Tên công ty:</strong> @(string.IsNullOrWhiteSpace(Model.CompanyName) ? "-" : Model.CompanyName)</p>
                <p class="mb-1"><strong>Lĩnh vực:</strong> @(string.IsNullOrWhiteSpace(Model.CompanyIndustry) ? "-" : Model.CompanyIndustry)</p>
                <p class="mb-0">
                    <strong>Trạng thái xác minh:</strong>
                    @if (Model.IsVerified)
                    {
                        <span class="badge bg-success">Đã xác minh</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Chưa xác minh</span>
                    }
                </p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a asp-action="EditProfile" class="btn btn-outline-primary">Chỉnh sửa hồ sơ</a>
    <a asp-action="CreateJob" class="btn btn-primary">Đăng tin tuyển dụng mới</a>
    <a asp-action="JobPostingList" class="btn btn-outline-primary">Quản lý tin tuyển dụng</a>
</div>
