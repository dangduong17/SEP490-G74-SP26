@model vn.edu.fpt.dto.AdminUserListViewModel
@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<form method="get" asp-action="UserList" class="row g-2 mb-3">
    <div class="col-md-4">
        <input class="form-control" name="keyword" value="@Model.Keyword" placeholder="Tìm theo email, tên, số điện thoại..." />
    </div>
    <div class="col-md-2">
        <select class="form-select" name="role">
            <option value="">Tất cả vai trò</option>
            <option value="Admin" selected="@(Model.Role == "Admin" ? "selected" : null)">Admin</option>
            <option value="Candidate" selected="@(Model.Role == "Candidate" ? "selected" : null)">Ứng viên</option>
            <option value="Recruiter" selected="@(Model.Role == "Recruiter" ? "selected" : null)">Nhà tuyển dụng</option>
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" name="status">
            <option value="">Tất cả trạng thái</option>
            <option value="active" selected="@(Model.Status == "active" ? "selected" : null)">Hoạt động</option>
            <option value="inactive" selected="@(Model.Status == "inactive" ? "selected" : null)">Ngưng hoạt động</option>
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" name="pageSize">
            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10 / page</option>
            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20 / page</option>
            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 / page</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button class="btn btn-topcv" type="submit">Lọc</button>
    </div>
</form>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="CreateAdmin" class="btn btn-outline-success btn-sm">Tạo admin</a>
    <a asp-action="CreateCandidate" class="btn btn-outline-success btn-sm">Tạo ứng viên</a>
    <a asp-action="CreateRecruiter" class="btn btn-outline-success btn-sm">Tạo nhà tuyển dụng</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Email</th>
                <th>Họ tên</th>
                <th>Số điện thoại</th>
                <th>Vai trò</th>
                <th>Ngày tạo</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Users.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">Không có người dùng phù hợp.</td>
                </tr>
            }
            else
            {
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.FullName</td>
                        <td>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber)</td>
                        <td><span class="badge bg-secondary">@user.Role</span></td>
                        <td>@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Ngưng hoạt động</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Sửa</a>
                            @if (user.IsActive)
                            {
                                <form asp-action="DeleteUser" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Chuyển người dùng này sang ngưng hoạt động?');">
                                        Xóa
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@{
    var prevPage = Model.Page - 1;
    var nextPage = Model.Page + 1;
}
<nav>
    <ul class="pagination mb-0">
        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="UserList"
               asp-route-page="@prevPage"
               asp-route-pageSize="@Model.PageSize"
               asp-route-keyword="@Model.Keyword"
               asp-route-role="@Model.Role"
               asp-route-status="@Model.Status">Trước</a>
        </li>
        <li class="page-item disabled">
            <span class="page-link">Trang @Model.Page / @Model.TotalPages</span>
        </li>
        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link"
               asp-action="UserList"
               asp-route-page="@nextPage"
               asp-route-pageSize="@Model.PageSize"
               asp-route-keyword="@Model.Keyword"
               asp-route-role="@Model.Role"
               asp-route-status="@Model.Status">Sau</a>
        </li>
    </ul>
</nav>
