@{
    ViewData["Title"] = "Quản lý CV";
}

<section class="page-section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="page-title mb-0">Danh sách CV của bạn</h2>
            <a asp-action="CreateCV" class="btn btn-primary">Tạo CV mới</a>
        </div>

        <!-- CV Templates Banner -->
        <div class="alert alert-info mb-4">
            <div class="d-flex align-items-center">
                <i class="fas fa-info-circle fa-2x me-3"></i>
                <div>
                    <strong>Tạo CV chuyên nghiệp miễn phí!</strong>
                    <p class="mb-0">Hơn 100+ mẫu CV đẹp, chuẩn theo từng ngành nghề. Dễ dàng tùy chỉnh và tải xuống.</p>
                </div>
            </div>
        </div>

        <!-- CV List -->
        <div class="row">
            @for (int i = 0; i < 6; i++)
            {
                <div class="col-md-4 mb-4">
                    <div class="cv-card">
                        <div class="cv-preview">
                            <div class="cv-preview-placeholder">
                                <i class="fas fa-file-alt fa-3x"></i>
                            </div>
                        </div>
                        <div class="cv-card-body">
                            <h5 class="cv-title">CV Nhân viên kinh doanh</h5>
                            <p class="cv-meta">
                                <small class="text-muted">
                                    Cập nhật: 05/02/2026
                                </small>
                            </p>
                            <div class="cv-stats">
                                <span class="cv-stat">
                                    <i class="fas fa-eye"></i> 45 lượt xem
                                </span>
                                <span class="cv-stat">
                                    <i class="fas fa-download"></i> 12 tải xuống
                                </span>
                            </div>
                        </div>
                        <div class="cv-card-footer">
                            <a href="#" class="btn btn-sm btn-outline-primary">Xem</a>
                            <a href="#" class="btn btn-sm btn-outline-secondary">Sửa</a>
                            <a href="#" class="btn btn-sm btn-outline-success">Tải xuống</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Empty State (nếu chưa có CV)
        <div class="empty-state">
            <i class="fas fa-file-alt fa-4x text-muted mb-3"></i>
            <h4>Chưa có CV nào</h4>
            <p class="text-muted">Bắt đầu tạo CV chuyên nghiệp để ứng tuyển việc làm</p>
            <a asp-action="CreateCV" class="btn btn-primary">Tạo CV đầu tiên</a>
        </div>
        *@
    </div>
</section>