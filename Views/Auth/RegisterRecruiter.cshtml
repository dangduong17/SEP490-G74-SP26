@model vn.edu.fpt.dto.RegisterDto
@{
    ViewData["Title"] = "Đăng ký Nhà tuyển dụng";
}

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="auth-card">
                    <div class="auth-header text-center">
                        <h2 class="auth-title">Đăng ký Nhà tuyển dụng</h2>
                        <p class="auth-subtitle">Tạo tài khoản để đăng tin tuyển dụng trên Finding Jobs</p>
                    </div>
                    
                    <form asp-action="RegisterRecruiter" method="post" class="auth-form">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <input type="hidden" name="role" value="Recruiter" />
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Họ</label>
                                <input name="firstName" class="form-control" placeholder="Nhập họ" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Tên</label>
                                <input name="lastName" class="form-control" placeholder="Nhập tên" required />
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input name="email" class="form-control" type="email" placeholder="name@example.com" required />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu</label>
                            <input name="password" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nhập lại mật khẩu</label>
                            <input name="confirmPassword" class="form-control" type="password" placeholder="Xác nhận mật khẩu" required />
                        </div>
                        
                        <div class="mb-3">
                            <a asp-action="Register" class="btn btn-outline-secondary w-100">
                                <i class="bi bi-person me-2"></i>Bạn là Người dùng tìm việc? Đăng ký tại đây
                            </a>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                                <label class="form-check-label" for="agreeTerms">
                                    Tôi đồng ý với <a href="#">Điều khoản dịch vụ</a> và <a href="#">Chính sách bảo mật</a>
                                </label>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 btn-auth">Đăng ký Nhà tuyển dụng</button>
                        
                        <div class="auth-divider">
                            <span>hoặc</span>
                        </div>
                        
                        <div class="text-center">
                            <p class="auth-link-text">
                                Đã có tài khoản? <a asp-action="Login" class="auth-link">Đăng nhập ngay</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
