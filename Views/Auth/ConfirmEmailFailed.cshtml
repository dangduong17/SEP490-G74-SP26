@{
    ViewData["Title"] = "Xác nhận Email thất bại";
}

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="auth-card text-center">
                    <div class="auth-header">
                        <div class="mb-4 text-danger">
                            <i class="bi bi-x-circle-fill" style="font-size: 4rem;"></i>
                        </div>
                        <h2 class="auth-title">Xác nhận thất bại</h2>
                        <p class="auth-subtitle text-danger">@ViewBag.ErrorMessage</p>
                    </div>
                    
                    <div class="auth-body mt-4">
                        <p>Có vẻ như liên kết kích hoạt của bạn đã quá hạn (sau 3 giờ) hoặc không còn hợp lệ.</p>
                        <p>Vui lòng nhấn nút dưới đây để nhận một mã kích hoạt mới qua email.</p>
                        
                        <a asp-action="ResendConfirmation" asp-route-email="@ViewBag.UserEmail" class="btn btn-primary w-100 btn-auth mt-3">
                            <i class="bi bi-envelope-fill me-2"></i>Gửi lại email kích hoạt
                        </a>
                    </div>
                    
                    <div class="auth-footer mt-4">
                        <a asp-action="Login" class="auth-link">Quay lại trang Đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
