@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="auth-card">
                    <div class="auth-header">
                        <h2 class="auth-title">Quên mật khẩu</h2>
                        <p class="auth-subtitle">Nhập email của bạn để nhận mật khẩu mới</p>
                    </div>


                    <form asp-action="ForgotPassword" method="post" class="auth-form">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input name="email" class="form-control" type="email" placeholder="name@example.com" required />
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 btn-auth">Gửi mật khẩu mới</button>
                        
                        <div class="text-center mt-3">
                            <a asp-action="Login" class="auth-link">Quay lại đăng nhập</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
