@{
    ViewData["Title"] = "Tìm việc làm";
}

<section class="page-section">
    <div class="container">
        <!-- Search & Filter -->
        <div class="search-filter-wrapper">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" placeholder="Tìm kiếm việc làm...">
                </div>
                <div class="col-md-3">
                    <select class="form-select">
                        <option>Tất cả ngành nghề</option>
                        <option>IT - Phần mềm</option>
                        <option>Marketing</option>
                        <option>Kinh doanh</option>
                        <option>Kế toán</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select">
                        <option>Tất cả địa điểm</option>
                        <option>Hà Nội</option>
                        <option>TP. Hồ Chí Minh</option>
                        <option>Đà Nẵng</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100">Tìm kiếm</button>
                </div>
            </div>
        </div>

        <!-- Job List -->
        <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Tìm thấy 1,234 việc làm</h4>
                <select class="form-select" style="width: auto;">
                    <option>Mới nhất</option>
                    <option>Lương cao nhất</option>
                    <option>Phù hợp nhất</option>
                </select>
            </div>

            <div class="row">
                @for (int i = 0; i < 12; i++)
                {
                    <div class="col-md-6 col-lg-4 mb-3">
                        <div class="job-card">
                            <div class="job-card-header">
                                <div class="company-logo">
                                    <i class="fas fa-building"></i>
                                </div>
                                <button class="btn-save"><i class="far fa-heart"></i></button>
                            </div>
                            <div class="job-card-body">
                                <h5 class="job-title">
                                    <a href="#">Nhân Viên Kinh Doanh (@(i + 1))</a>
                                </h5>
                                <p class="company-name">Công ty TNHH ABC</p>
                                <div class="job-info">
                                    <span class="salary">15 - 25 triệu</span>
                                    <span class="location">Hà Nội</span>
                                </div>
                                <div class="job-tags">
                                    <span class="job-tag">Full-time</span>
                                    <span class="job-tag">2 năm kinh nghiệm</span>
                                </div>
                            </div>
                            <div class="job-card-footer">
                                <span class="job-date">2 ngày trước</span>
                                <a href="#" class="btn btn-sm btn-primary">Ứng tuyển</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#">Sau</a></li>
                </ul>
            </nav>
        </div>
    </div>
</section>