@{
    ViewData["Title"] = "Dashboard Ứng viên";
}

<section class="page-section">
    <div class="container">
        <h2 class="page-title">Dashboard Ứng viên</h2>

        <!-- Stats Cards -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-primary">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div class="stat-content">
                        <h3>5</h3>
                        <p>CV đã tạo</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-success">
                        <i class="fas fa-paper-plane"></i>
                    </div>
                    <div class="stat-content">
                        <h3>12</h3>
                        <p>Đã ứng tuyển</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-warning">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-content">
                        <h3>8</h3>
                        <p>Đang chờ</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-info">
                        <i class="fas fa-heart"></i>
                    </div>
                    <div class="stat-content">
                        <h3>23</h3>
                        <p>Việc đã lưu</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Applications -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Đơn ứng tuyển gần đây</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Vị trí</th>
                                <th>Công ty</th>
                                <th>Ngày ứng tuyển</th>
                                <th>Trạng thái</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 5; i++)
                            {
                                <tr>
                                    <td><strong>Nhân viên kinh doanh</strong></td>
                                    <td>Công ty ABC</td>
                                    <td>05/02/2026</td>
                                    <td><span class="badge bg-warning">Đang xem xét</span></td>
                                    <td>
                                        <a href="#" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recommended Jobs -->
        <div class="mt-4">
            <h5 class="mb-3">Việc làm đề xuất</h5>
            <div class="row">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="col-md-4 mb-3">
                        <div class="job-card">
                            <div class="job-card-header">
                                <div class="company-logo">
                                    <i class="fas fa-building"></i>
                                </div>
                            </div>
                            <div class="job-card-body">
                                <h5 class="job-title">
                                    <a href="#">Marketing Executive</a>
                                </h5>
                                <p class="company-name">Công ty XYZ</p>
                                <div class="job-info">
                                    <span class="salary">10 - 15 triệu</span>
                                    <span class="location">TP.HCM</span>
                                </div>
                            </div>
                            <div class="job-card-footer">
                                <span class="job-date">1 ngày trước</span>
                                <a href="#" class="btn btn-sm btn-primary">Ứng tuyển</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>